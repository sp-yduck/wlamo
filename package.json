{
  "name": "wlamo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PLaMo 3 Translate 0.8B running fully in the browser via wllama, served from Cloudflare Workers",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@wllama/wllama": "file:vendor/wllama",
    "vite": "^8.3.6",
    "wrangler": "^4.157.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "typescript": "^7.0.2"
  }
}
